---
/* Les primitives du cerisier, définies une fois et réutilisées partout :
   un pétale, une fleur, un bourgeon, deux rameaux.

   Le pétale est dessiné, pas approché : cinq cercles disposés en étoile
   donnent une rosace de clipart. Un pétale de cerisier a une taille étroite,
   un ventre large et une échancrure au sommet, et c'est elle qui
   fait qu'on reconnaît un cerisier et pas une marguerite.

   Les cinq pétales sont posés à 70°/76°/68°/74°/72° et non tous à 72°, avec
   des échelles à 3 % près : une fleur vraie n'est pas symétrique, et l'œil lit
   la symétrie parfaite comme du gabarit.

   Le rameau est un ruban fuselé, pas un trait d'épaisseur constante : une
   branche s'amincit en s'éloignant du tronc, et c'est ce fuselé qui la sort
   du pictogramme. */
---

<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false"
  ><defs>
    <g id="s-petal">
      <path
        d="M0 1.1
           C-2.7-1.3 -5.5-4.4 -5.6-8.1
           C-5.7-11.1 -3.9-13.1 -1.9-12.8
           C-1-12.6 -.35-11.6 0-9.5
           C.35-11.6 1-12.6 1.9-12.8
           C3.9-13.1 5.7-11.1 5.6-8.1
           C5.5-4.4 2.7-1.3 0 1.1 Z"></path>
    </g>
    <symbol id="s-bl" viewBox="-14 -14 28 28">
      <g transform="rotate(-8) scale(1,.96)">
        <use href="#s-petal"></use>
        <use href="#s-petal" transform="rotate(70) scale(.97,1.03)"></use>
        <use href="#s-petal" transform="rotate(146) scale(1.03,.98)"></use>
        <use href="#s-petal" transform="rotate(214) scale(.98,1.01)"></use>
        <use href="#s-petal" transform="rotate(288) scale(1.02,.99)"></use>
      </g>
    </symbol>

    {/* Le bourgeon : la même fleur avant qu'elle s'ouvre. */}
    <symbol id="s-bud" viewBox="-8 -8 16 16">
      <path
        d="M0-6.9 C2.7-6.2 4.4-4 4.4-1.5 C4.4 1.6 2.4 3.6 0 3.6
           C-2.4 3.6 -4.4 1.6 -4.4-1.5 C-4.4-4 -2.7-6.2 0-6.9 Z"></path>
    </symbol>

    {/* Le viewBox est haut (100 pour 1200) parce que le séparateur fait toute
        la largeur de la page : à 56 de haut, le rameau se rendait sur 55 px et
        se lisait comme un filet ponctué de miettes, pas comme une branche. */}
    <symbol id="s-branch" viewBox="0 0 1200 100">
      <path
        fill="currentColor"
        d="M0 78.6 C 168 73.6, 300 61.4, 432 52.4
           C 622 39.4, 834 29.4, 1200 21.2 L 1200 23
           C 834 32.6, 622 44.6, 432 59.6 C 300 69.6, 168 81.8, 0 85.4 Z"></path>
      <g fill="none" stroke="currentColor" stroke-linecap="round">
        <path stroke-width="2.4" d="M243 72.4 C 258 62, 266 50, 264 37"></path>
        <path stroke-width="1.5" d="M257 60 C 266 55, 274 51, 282 48"></path>
        <path stroke-width="1.9" d="M596 47.4 C 613 43, 628 47, 640 58"></path>
        <path stroke-width="2.1" d="M900 30.2 C 914 19, 930 14, 946 19"></path>
        <path stroke-width="1.5" d="M414 60.6 C 426 55, 438 55.6, 447 61"></path>
        <path stroke-width="1.3" d="M1104 24.6 C 1116 19, 1128 18.4, 1138 22"></path>
      </g>
      <g fill="currentColor">
        <use href="#s-bl" x="-17" y="-17" width="34" height="34" transform="translate(264,37) rotate(-12)"></use>
        <use href="#s-bl" x="-11" y="-11" width="22" height="22" transform="translate(282,48) rotate(58)"></use>
        <use href="#s-bl" x="-13" y="-13" width="26" height="26" transform="translate(640,58) rotate(26)"></use>
        <use href="#s-bl" x="-16" y="-16" width="32" height="32" transform="translate(946,19) rotate(-34)"></use>
        <use href="#s-bl" x="-10" y="-10" width="20" height="20" transform="translate(1138,22) rotate(48)"></use>
        <use href="#s-bl" x="-12" y="-12" width="24" height="24" transform="translate(70,80.6) rotate(-26)"></use>
        <use href="#s-bud" x="-5.5" y="-5.5" width="11" height="11" transform="translate(447,61) rotate(20)"></use>
        <use href="#s-bud" x="-4.6" y="-4.6" width="9.2" height="9.2" transform="translate(742,38.6) rotate(-42)"></use>
        <use href="#s-bud" x="-5" y="-5" width="10" height="10" transform="translate(176,77) rotate(60)"></use>
        <use href="#s-bud" x="-4.2" y="-4.2" width="8.4" height="8.4" transform="translate(1020,26) rotate(14)"></use>
      </g>
    </symbol>

    <symbol id="s-spray" viewBox="0 0 300 190">
      <path
        fill="currentColor"
        d="M2 180.4 C 64 168, 107 140, 141 101.6
           C 183 54, 220 27.4, 297 18.2 L 297 21.8
           C 222 31, 187 57.4, 145 104.6 C 110 143.6, 66 171.4, 3 184 Z"></path>
      <g fill="none" stroke="currentColor" stroke-linecap="round">
        <path stroke-width="2" d="M114 124 C 131 109, 140 88, 138 65"></path>
        <path stroke-width="1.7" d="M188 61 C 207 59, 221 70, 233 87"></path>
        <path stroke-width="1.5" d="M234 43 C 247 33, 263 31, 279 39"></path>
        <path stroke-width="1.2" d="M74 156 C 82 145, 92 139, 104 137"></path>
      </g>
      <g fill="currentColor">
        <use href="#s-bl" x="-16" y="-16" width="32" height="32" transform="translate(138,65) rotate(-14)"></use>
        <use href="#s-bl" x="-13" y="-13" width="26" height="26" transform="translate(233,87) rotate(28)"></use>
        <use href="#s-bl" x="-15.5" y="-15.5" width="31" height="31" transform="translate(279,39) rotate(-38)"></use>
        <use href="#s-bl" x="-10.5" y="-10.5" width="21" height="21" transform="translate(186,60) rotate(52)"></use>
        <use href="#s-bl" x="-13" y="-13" width="26" height="26" transform="translate(296,19) rotate(10)"></use>
        <use href="#s-bl" x="-12" y="-12" width="24" height="24" transform="translate(104,137) rotate(-24)"></use>
        <use href="#s-bl" x="-9" y="-9" width="18" height="18" transform="translate(58,168) rotate(66)"></use>
        <use href="#s-bud" x="-4.4" y="-4.4" width="8.8" height="8.8" transform="translate(160,80) rotate(-20)"></use>
        <use href="#s-bud" x="-4" y="-4" width="8" height="8" transform="translate(252,58) rotate(34)"></use>
        <use href="#s-bud" x="-4.6" y="-4.6" width="9.2" height="9.2" transform="translate(88,150) rotate(-8)"></use>
      </g>
    </symbol>
  </defs></svg
>
